# Copy to `.env` (gitignored) only if your shell/tooling loads it automatically.
# Nothing in this repo reads a `.env` file itself — every script reads these
# from real process environment variables. Never commit a real key.

# Jev / TypeSafe API key. Only needed for `npm run assess:jev-live`,
# `npm run smoke:jev`, `npm run smoke:jev-mcp`, and `npm run mcp:jev`.
# On macOS, prefer `npm run jev:secret:set` (stores it in Keychain) instead
# of this variable — assess-jev-live.ts uses this env var only if you set
# it explicitly, and falls back to Keychain otherwise. CI and non-macOS
# machines should set this directly from their own secret manager.
TYPESAFE_API_KEY=

# Exact-match confirmation required to run a real, billed live Jev call.
# Never set this in a committed file, CI default, or shell profile — it
# exists so a live run can only ever be deliberate.
JEV_SMOKE_CONFIRM=I_UNDERSTAND_THIS_MAKES_ONE_LIVE_JEV_CALL

# Optional: only used to compute a cost estimate in evidence-out-live-jev/usage.json.
# Omit both to skip cost calculation (real token usage is still recorded either way).
JEV_PRICE_PER_1K_INPUT_TOKENS_USD=
JEV_PRICE_PER_1K_OUTPUT_TOKENS_USD=

# Test/CI-only escape hatch: forces npm run assess:jev-live's gate to skip
# the macOS Keychain lookup, so its behavior doesn't depend on whatever is
# (or isn't) stored on the machine running the tests. Never set this to
# make a real run succeed — it only ever removes a secret source.
JEV_SKIP_KEYCHAIN=

# Optional: override the port for `npm run ui` (default 4790).
PORT=
