{
  "name": "responsible-ai-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Model-agnostic assessment harness for AI models and agents: deterministic hard rules before replaceable judges, evidence-first findings, offline-verifiable bundles.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx scripts/run-demo.ts",
    "ui": "tsx scripts/serve-report-ui.ts",
    "assess:jev-live": "tsx scripts/assess-jev-live.ts",
    "jev:secret:set": "tsx scripts/jev-secret.ts set",
    "jev:secret:remove": "tsx scripts/jev-secret.ts remove",
    "jev:secret:status": "tsx scripts/jev-secret.ts status",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke:jev": "tsx scripts/smoke-jev.ts",
    "smoke:jev-mcp": "tsx scripts/smoke-jev-mcp.ts",
    "mcp:jev": "tsx scripts/mcp-jev-connector-serve.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@typesafe-ai/sdk": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "tsx": "^4.23.13",
    "typescript": "5.7",
    "typescript-eslint": "^8.70.0",
    "vitest": "5.0.1"
  }
}